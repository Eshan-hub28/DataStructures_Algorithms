//my logic but brute force approach
class Solution {
    public int[] leftRightDifference(int[] nums) {
        int n=nums.length;
        int[] leftArr=new int[n];
        int[] rightArr=new int[n];
        leftArr[0]=0;
        for(int i=1;i<n;i++){
            leftArr[i]=leftArr[i-1]+nums[i-1];
        }
        rightArr[n-1]=0;
        for(int i=0;i<n-1;i++){
            int rightSum=0;
            for(int j=i+1;j<n;j++){
                rightSum+=nums[j];
            }
            rightArr[i]=rightSum;
        }
        int[] ans=new int[n];
        for(int i=0;i<n;i++){
            int res=Math.abs(leftArr[i]-rightArr[i]);
            ans[i]=res;
        }
        return ans;
    }
}

//optimized logic 
class Solution {
    public int[] leftRightDifference(int[] nums) {

        int n = nums.length;

        // Find total sum
        int total = 0;

        for(int num : nums) {
            total += num;
        }

        int[] ans = new int[n];

        int leftSum = 0;

        for(int i = 0; i < n; i++) {

            // Everything except left side and current element
            // is the right side
            int rightSum = total - leftSum - nums[i];

            ans[i] = Math.abs(leftSum - rightSum);

            // Add current element for the next index
            leftSum += nums[i];
        }

        return ans;
    }
}