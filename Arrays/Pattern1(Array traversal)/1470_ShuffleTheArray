
class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] arr=new int[nums.length];
        int k=0;
        int j=1;
        for(int i=0;i<nums.length;i++){
            if(i<n){
                arr[k]=nums[i];
                k+=2;
            }
            else{
                arr[j]=nums[i];
                j+=2;
            }
        }
        return arr;
    }
}