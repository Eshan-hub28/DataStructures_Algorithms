class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        int maxi=0;
        List<Boolean> result=new ArrayList<>();
        for(int i=0;i<candies.length;i++){
            maxi=Math.max(candies[i],maxi);
        }
        for(int i=0;i<candies.length;i++){
            int sum=candies[i]+extraCandies;
            if(sum>=maxi){
                result.add(true);
            }else{
                result.add(false);
            }
        }
        return result;
        
    }
}