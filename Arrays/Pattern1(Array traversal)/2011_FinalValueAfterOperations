class Solution {
    public int finalValueAfterOperations(String[] operations) {
        int count=0;
        for(String sentence:operations){
            for(int i=0;i<sentence.length();i++){
                if(sentence.charAt(1)=='+'){
                    count++;
                }
                else if(sentence.charAt(1)=='-'){
                    count--;
                }
            }

        }
        return count;
    }
}