class Solution {
    public int firstUniqChar(String s) {

        int[] freq = new int[128];

        // Step 1: Count frequency of every character
        for(char ch : s.toCharArray()){
            freq[ch]++;
        }


        // Step 2: Find first character with frequency 1
        for(int i = 0; i < s.length(); i++){

            char ch = s.charAt(i);

            if(freq[ch] == 1){
                return i;
            }
        }

        return -1;
    }
}