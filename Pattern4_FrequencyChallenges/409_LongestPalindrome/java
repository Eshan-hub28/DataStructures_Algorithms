class Solution {
    public int longestPalindrome(String s) {
        int[] freq=new int[128];
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            freq[ch]++;
        }
        int length=0;
        boolean odd=false;
        for(int count:freq){
            length+=(count/2)*2;
            if(count%2==1){
                odd=true;
            }
        }
        if(odd){
            length++;
        }
        return length;
    }
}


using HashMap
import java.util.HashMap;

class Solution {
    public int longestPalindrome(String s) {

        HashMap<Character, Integer> map = new HashMap<>();

        // Step 1: Count frequency
        for(char ch : s.toCharArray()) {
            map.put(ch, map.getOrDefault(ch, 0) + 1);
        }


        int length = 0;
        boolean hasOdd = false;


        // Step 2: Use frequencies
        for(int freq : map.values()) {

            // Take all possible pairs
            length += (freq / 2) * 2;


            // If any odd frequency exists,
            // one character can go in the center
            if(freq % 2 == 1) {
                hasOdd = true;
            }
        }


        // Add middle character
        if(hasOdd) {
            length++;
        }


        return length;
    }
}