class Solution{
    public boolean uniqueOccurrences(int[] arr){
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int num:arr){
            map.put(num,map.getOrDefault(num,0)+1);
        }
        HashSet<Integer> seen=new HashSet<>();
        for(int num:map.values()){
            if(seen.contains(num)){
                return false;
            }
            seen.add(num);
        }
        return true;
    }
}