class Solution:
    def canConstruct(self, ransomNote, magazine):
        freq = [0] * 26

        for ch in magazine:
            freq[ord(ch) - ord('a')] += 1

        for ch in ransomNote:
            freq[ord(ch) - ord('a')] -= 1

        for i in range(26):
            if freq[i] < 0:
                return False
        return True