class Solution(object):
    def wordPattern(self, pattern, s):
        map1={}
        map2={}
        words=s.split(" ")
        if len(pattern)!=len(words):
            return False
        for i in range(len(pattern)):
            ch=pattern[i]
            word=words[i]
            if ch in map1:
                if map1[ch]!=word:
                    return False
            else:
                map1[ch]=word
            if word in map2:
                if map2[word]!=ch:
                    return False
            else:
                map2[word]=ch
        return True
        